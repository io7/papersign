# PaperSign Docker settings. Copy to docker/.env and fill in. Keep .env private:
# it holds the database password and the secret that protects sessions and links.

# The address people type to open PaperSign: scheme and host, no path.
# Use https in production. With the bundled Caddy (below) this is also the
# address Caddy obtains a certificate for.
APP_URL=https://papersign.example.com

# Who runs this installation, shown on the privacy page as the service
# operator, for example your company's name.
OPERATOR_NAME=

# Generate each with: openssl rand -hex 32
# BETTER_AUTH_SECRET also encrypts stored signing links. Back it up together
# with the data and database volumes; restoring one without the others fails.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Optional parts, comma-separated:
#   https    Caddy answers on ports 80 and 443 and obtains the certificate for
#            APP_URL by itself. The domain must already point at this server.
#   try-out  a local mailbox that captures every email (see below).
# Leave empty when your own reverse proxy handles HTTPS.
COMPOSE_PROFILES=https

# Optional Caddy global options, for example `email you@example.com` for
# certificate notices, or `local_certs` to use Caddy's own certificate
# authority on a private network.
CADDY_GLOBAL_OPTIONS=

# Where the web container listens on this host. Keep 127.0.0.1: the bundled
# Caddy reaches it inside Docker, and a reverse proxy on this host uses it.
PAPERSIGN_BIND=127.0.0.1
PAPERSIGN_PORT=3176

# Addresses of the reverse proxy as PaperSign sees it, comma-separated IPs or
# CIDR ranges. Only these may supply the visitor's real address, which the
# sign-in and email-code rate limits use. 172.16.0.0/12 is Docker's default
# range: right for the bundled Caddy and for a proxy on this host.
TRUSTED_PROXY=172.16.0.0/12

# Email is required: verification, password recovery and every signer's
# one-time code are sent by email, and those steps fail without it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperSign <papersign@example.com>
# Keep true. Set false only for a trusted relay on the same private network,
# such as the try-out mailbox below.
SMTP_REQUIRE_TLS=true

# Or send through Postmark's HTTP API instead of SMTP: leave SMTP_HOST empty,
# set the server's API token (not an SMTP token) and the sender. The API
# refuses a message it cannot send at once, so PaperSign shows the failure;
# Postmark's SMTP endpoint accepts first and can drop the message later.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Sender for either way of sending; SMTP_FROM above also works.
MAIL_FROM=

# Optional: email server errors to this address (throttled to one per kind
# every 15 minutes; no signing links, tokens or document content). Uses the
# email delivery above. Check it with `docker compose exec web papersign test-alert`.
ERROR_ALERT_EMAIL=

# Trying PaperSign without a mail server: set COMPOSE_PROFILES=try-out and
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_REQUIRE_TLS=false
#   SMTP_USER=
#   SMTP_PASSWORD=
# Every email then appears at http://localhost:8025 and nobody receives it.
MAILPIT_BIND=127.0.0.1

# Public sign-up. Leave true until your own account exists and is an Admin,
# then set false; invited people can still create accounts.
REGISTRATION_ENABLED=true

# Optional: where `papersign monitor` posts failures and recoveries (JSON).
# With ERROR_ALERT_EMAIL set, the monitor emails them as well.
ALERT_WEBHOOK_URL=

# Optional limits.
ACCOUNT_STORAGE_LIMIT_BYTES=524288000
MAX_ACTIVE_EXPORTS=3
DELETION_GRACE_DAYS=30
DELETION_APPROVAL_REQUIRED=false

# Image to run. Leave unset for the release this checkout belongs to. To build
# from the checkout instead, set papersign:local and run
# `docker compose up -d --build`.
# PAPERSIGN_IMAGE=papersign:local
