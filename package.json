{
  "name": "papersign",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "worker": "node dist-server/server/worker.js",
    "dev:worker": "tsx server/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@libpdf/core": "0.5.3",
    "@lucide/vue": "1.61.0",
    "@napi-rs/canvas": "1.0.12",
    "asn1js": "3.1.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pkijs": "3.4.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "signature_pad": "5.1.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "jsqr": "1.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
