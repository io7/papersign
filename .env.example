DATABASE_URL=postgres://papersign:replace-with-a-random-password@127.0.0.1:54376/papersign
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:3176
HOST=127.0.0.1
PORT=3176
DATA_DIR=.local/data
REGISTRATION_ENABLED=true
# Who runs this installation, shown on the privacy page as the service operator.
# OPERATOR_NAME=Example Ltd
ACCOUNT_STORAGE_LIMIT_BYTES=524288000
MAX_ACTIVE_EXPORTS=3
# Completed records do not expire automatically. An owner request starts this
# recovery period; permanent deletion requires a separate guarded operator purge.
# Set DELETION_APPROVAL_REQUIRED=true to require prior Admin review as well.
DELETION_APPROVAL_REQUIRED=false
DELETION_GRACE_DAYS=30
BACKUP_FILE=/var/lib/postgresql/papersign.dump
# Optional monitoring notifications; configure only an approved destination.
# Without a webhook, the monitor writes status to the system journal only.
# ALERT_WEBHOOK_URL=https://your-approved-monitor.example/papersign
# Optional standalone RFC 3161 evidence timestamps. No organization key needed.
# Supply an authorized TSA, independently trusted roots and supported CRL URLs.
# See docs/signing-evidence.md. Leave unset until provider validation is complete.
# EVIDENCE_TIMESTAMP_POLICY=/etc/papersign/timestamp-policy.json
# Optional certificate sealing. Configure both only after the isolated sealer is
# provisioned and tested. Never put the signing key or password in this file.
# See CERTIFICATE-SEALING.md.
# SEAL_SOCKET=/run/papersign-sealer/sealer.sock
# SEAL_POLICY_ID=<SHA256 printed by server/sealing/policy-id.js>
# Production: trust only the actual reverse proxy, never arbitrary forwarded headers.
# TRUSTED_PROXY=10.0.0.5
# Email verification, password recovery and recipient signing require SMTP.
# These flows fail closed when mail is unavailable; copied links do not bypass
# mailbox verification. Configure production sender/domain and verify delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=PaperSign <papersign@example.com>
# Remote SMTP must use TLS. Set false only for a trusted relay on the same
# private network (for example a mail container in the same compose project).
# SMTP_REQUIRE_TLS=true
# Local tests ONLY: start `node --import tsx scripts/dev-mail.ts`, then use:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2526
# SMTP_SECURE=false
# SMTP_FROM=PaperSign Test <papersign@example.invalid>
# No SMTP_USER or SMTP_PASSWORD for the local sink. It accepts only
# example.invalid/example.test recipients and never relays messages.
